# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub

# Your Groq API key from console.groq.com (free, no billing needed)
GROQ_API_KEY=your_groq_api_key_here

# The CSV export URL of your Google Sheet (must be published to web)
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vSt_LKlRsjm7IvCXh7TQ6YDgvrAlRHTUhxR8CcwmK6wddLbvGORZSvjAKYTvubzLLNSyKdkk-1HYgAw/pub?output=csv

# Paste the ENTIRE contents of your service_account.json file here as one line
# On Linux/Mac: python3 -c "import json,sys; print(json.dumps(json.load(open('service_account.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Port the server runs on (optional, defaults to 8000)
PORT=8000
