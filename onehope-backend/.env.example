# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# The Drive folder holding the resources (last part of the folder's URL).
# Share the folder with the service account's client_email as Viewer.
DRIVE_FOLDER_ID=

# Paste the entire contents of your service account JSON file as one line:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Postgres connection string (free Neon or Supabase). Leave blank locally to use
# a SQLite file; set it in production so documents survive restarts.
DATABASE_URL=

# Optional: the resource sheet, for extra search details (language, audience…).
SHEET_CSV_URL=

# ── Google Sign-In (required in production) ──────────────────────────────────
# Get your Client ID from: https://console.cloud.google.com → APIs & Services → Credentials
# If this is blank the API refuses all chat requests (unless AUTH_DISABLED=true).
GOOGLE_CLIENT_ID=

# Restrict sign-in to a specific email domain (e.g. onehope.net). Blank = any Google account.
ALLOWED_DOMAIN=

# Comma-separated emails that see the "Sync from Drive" button.
ADMIN_EMAILS=

# Comma-separated frontend URLs allowed to call the API (CORS).
# e.g. https://onehope-resources.netlify.app,http://localhost:5500
ALLOWED_ORIGINS=

# ── Optional tuning ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
SYNC_INTERVAL_MINUTES=10
# MAX_FILE_MB=60
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.1-8b-instant
# MAX_CHARS_PER_DOC=400000

# ── Local development only ────────────────────────────────────────────────────
# Skips Google Sign-In entirely. NEVER set this on the production server.
AUTH_DISABLED=true

# ── Hosting ───────────────────────────────────────────────────────────────────
# PORT is usually set automatically by the host — don't change it here.
PORT=8000
