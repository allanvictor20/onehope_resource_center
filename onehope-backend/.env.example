# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Paste the entire contents of your service account JSON file as one line:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Google Sign-In (optional — leave blank to disable auth during local dev) ──
# Get your Client ID from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=

# Restrict sign-in to a specific email domain (e.g. onehope.net).
# Leave blank to allow any Google account.
ALLOWED_DOMAIN=

# ── Hosting ───────────────────────────────────────────────────────────────────
# Set this on your hosting platform (Render, Railway, etc.)
# PORT is usually set automatically — don't change it here.
PORT=8000
